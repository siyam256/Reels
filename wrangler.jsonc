{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medilogy-poll-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "medilogy-poll-bot-db",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }]
}
